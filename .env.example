# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=1989
NODE_ENV=development

# Comma-separated list of frontend origins allowed via CORS and to fetch
# private portfolio media (profile pictures, CVs, project images).
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081

# Set to "false" to disable public self-signup (/auth/register, /auth/confirm) —
# useful for a single-user portfolio deployment. Defaults to enabled.
SIGNUPS_ENABLED=true

# Database (PostgreSQL via Sequelize)
DATABASE=ipsetego
DATABASE_USER=postgres
DATABASE_PASS=your_db_password
DATABASE_HOST=localhost

# Periodically pings the DB so free-tier providers (Supabase, Neon, Render, etc.)
# that pause/suspend on inactivity don't go to sleep. Set to "false" to disable.
DB_KEEPALIVE_ENABLED=true
# Standard cron syntax — default is every 5 minutes.
DB_KEEPALIVE_CRON=*/5 * * * *

# Auth — long random string used to sign JWTs
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_KEY=

# Field-level encryption (AES-256-CBC) for GDPR-sensitive user fields.
# Must be exactly 64 hex characters (32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Outbound email (SMTP) — used for OTPs, password resets, contact form, data export/deletion emails
SMTP_HOST=smtp.example.com
SMTP_PORT=465
# "false" switches to STARTTLS (typically paired with SMTP_PORT=587). Defaults to true (implicit TLS).
SMTP_SECURE=true
SERVICE_EMAIL=your_smtp_user@example.com
SERVICE_PASS=your_smtp_password_or_app_password
# Address emails are sent "from". Defaults to SERVICE_EMAIL if unset.
SMTP_FROM=service@example.com

# Supabase Storage — used for profile pictures, CVs, and project images
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_BUCKET_NAME=your_bucket_name

# Admin panel — comma-separated list of emails allowed to request an admin OTP login
ADMIN_WHITELIST=admin@example.com

# LLM backend used by the portfolio chat feature: "ollama" or "openai"
LLM_PROVIDER=ollama

# Used when LLM_PROVIDER=ollama — your Ollama server and model
HOST=http://localhost:11434
OLLAMA_MODEL=mistral

# Used when LLM_PROVIDER=openai — any OpenAI-compatible chat completions API
# (OpenAI, Groq, Together, a local vLLM/llama.cpp server, etc.)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Used to build links sent in emails (password reset, data export)
FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:1989

# ---------------------------------------------------------------------------
# Production deployment (docker-compose.prod.yml) — ignored for local runs
# ---------------------------------------------------------------------------

# Which published images to run. GHCR_OWNER is the GitHub account that owns the
# packages; IMAGE_TAG is "latest", a short commit sha, or a release tag.
GHCR_OWNER=guy1998
IMAGE_TAG=latest

# The public hostnames are NOT set here. HTTPS is terminated by the shared Caddy
# at the server root, and this app's domains live in caddy/ipsetego.caddy —
# ipsetego.com, app.ipsetego.com and api.ipsetego.com. Change them there.

# In production these three become the HTTPS domains, e.g.
#   ALLOWED_ORIGINS=https://ipsetego.com,https://www.ipsetego.com,https://app.ipsetego.com
#   FRONTEND_URL=https://ipsetego.com
#   BACKEND_URL=https://api.ipsetego.com
# Auth cookies are set with Secure + SameSite=None, so the frontends and the API
# may live on different subdomains, but everything must be served over HTTPS.
