# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=1989
NODE_ENV=development

# Comma-separated list of frontend origins allowed via CORS and to fetch
# private portfolio media (profile pictures, CVs, project images).
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081

# Set to "false" to disable public self-signup (/auth/register, /auth/confirm) —
# useful for a single-user portfolio deployment. Defaults to enabled.
SIGNUPS_ENABLED=true

# Database (PostgreSQL via Sequelize)
DATABASE=ipsetego
DATABASE_USER=postgres
DATABASE_PASS=your_db_password
DATABASE_HOST=localhost

# Auth — long random string used to sign JWTs
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_KEY=

# Field-level encryption (AES-256-CBC) for GDPR-sensitive user fields.
# Must be exactly 64 hex characters (32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Outbound email (SMTP) — used for OTPs, password resets, contact form, data export/deletion emails
SERVICE_EMAIL=your_smtp_user@example.com
SERVICE_PASS=your_smtp_password_or_app_password

# Supabase Storage — used for profile pictures, CVs, and project images
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_BUCKET_NAME=your_bucket_name

# Admin panel — comma-separated list of emails allowed to request an admin OTP login
ADMIN_WHITELIST=admin@example.com

# LLM backend used by the portfolio chat feature: "ollama" or "openai"
LLM_PROVIDER=ollama

# Used when LLM_PROVIDER=ollama — your Ollama server and model
HOST=http://localhost:11434
OLLAMA_MODEL=mistral

# Used when LLM_PROVIDER=openai — any OpenAI-compatible chat completions API
# (OpenAI, Groq, Together, a local vLLM/llama.cpp server, etc.)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Used to build links sent in emails (password reset, data export)
FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:1989
