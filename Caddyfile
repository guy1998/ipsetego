# Caddy obtains and renews Let's Encrypt certificates automatically for every
# site listed here, and redirects http:// to https:// on its own.
# Requirements: ports 80 and 443 open, and each domain's A record pointing at
# this server before the container starts.

{
	email {$ACME_EMAIL}
}

# ---- Public app ----
{$APP_DOMAIN}, www.{$APP_DOMAIN} {
	encode zstd gzip

	# Serve the apex domain, redirect www to it so there's a single canonical origin.
	@www host www.{$APP_DOMAIN}
	redir @www https://{$APP_DOMAIN}{uri} permanent

	reverse_proxy client:80
}

# ---- Admin panel ----
{$ADMIN_DOMAIN} {
	encode zstd gzip
	reverse_proxy admin-client:80
}

# ---- API ----
{$API_DOMAIN} {
	encode zstd gzip

	# Portfolio media (CVs, project images) can be large — don't buffer them.
	reverse_proxy backend:{$BACKEND_PORT} {
		flush_interval -1
	}
}
